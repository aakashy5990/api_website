<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background: #f8f9fa;
            margin: 0;
        }

        /* MAIN CONTENT FIX */
        .main-wrapper {
            margin-left: 260px;
            margin-top: 90px;
            padding: 20px;
        }

        /* CARD DESIGN */
        .dashboard-card {
            display: block;
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #eee;
            transition: all 0.3s ease;
        }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .icon-box {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .text-purple {
            color: #6f42c1;
        }

        .bg-purple-subtle {
            background: rgba(111, 66, 193, 0.1);
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <%- include('./partials/dasboardnav.ejs') %>

    <!-- SIDEBAR -->
    <%- include('./partials/sidebar.ejs') %>

    <!-- MAIN CONTENT -->
    <div class="main-wrapper">

        <!-- Welcome -->
        <div class="mb-4">
            <h2 class="fw-bold text-dark">
                Welcome back, <%= user.name || user.email || 'User' %>
            </h2>
            <p class="text-muted">Here’s what you can manage today</p>
        </div>

        <!-- GRID -->
        <div class="row g-4">

            <!-- Add Data -->
            <div class="col-md-6 col-lg-4">
                <a href="/adddata" class="dashboard-card text-decoration-none">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-primary-subtle text-primary">
                            <i class="fas fa-plus"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 text-dark">Add Data</h5>
                            <small class="text-muted">Create new dataset</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- My Data -->
            <div class="col-md-6 col-lg-4">
                <a href="/my/datasets" class="dashboard-card text-decoration-none">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-success-subtle text-success">
                            <i class="fas fa-list"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 text-dark">My Data</h5>
                            <small class="text-muted">Manage datasets</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Users API -->
            <div class="col-md-6 col-lg-4">
                <a href="/users" class="dashboard-card text-decoration-none">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-purple-subtle text-purple">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 text-dark">Users API</h5>
                            <small class="text-muted">View users JSON</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- External API -->
            <div class="col-md-6 col-lg-4">
                <a href="/external/nusers" class="dashboard-card text-decoration-none">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-warning-subtle text-warning">
                            <i class="fas fa-globe"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 text-dark">External API</h5>
                            <small class="text-muted">Third-party data</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Docs -->
            <div class="col-md-6 col-lg-4">
                <a href="/docs" class="dashboard-card text-decoration-none">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-danger-subtle text-danger">
                            <i class="fas fa-book"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 text-dark">Documentation</h5>
                            <small class="text-muted">Read API docs</small>
                        </div>
                    </div>
                </a>
            </div>

        </div>

        <!-- Footer -->
        <div class="mt-5 text-muted small">
            Manage your system efficiently 🚀
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>