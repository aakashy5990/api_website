<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background: #f8f9fa;
            margin: 0;
        }

        /* FULL WIDTH LAYOUT */
        .main-content {
            margin-left: 155px;
            padding: 20px;
        }

        /* CARD */
        .card {
            border-radius: 12px;
            border: 1px solid #eee;
        }

        /* BUTTON STYLE */
        .btn-custom {
            border-radius: 10px;
            padding: 14px;
            font-weight: 500;
            width: 100%;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-users {
            background: #e7f1ff;
            color: #0d6efd;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-users:hover {
            background: #0d6efd;
            color: #fff;
        }

        .btn-nusers {
            background: #e8f8f5;
            color: #17a2b8;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-nusers:hover {
            background: #17a2b8;
            color: #fff;
        }

        /* STATS */
        .stat-card {
            padding: 20px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid #eee;
        }

        .stat-card h3 {
            margin: 0;
        }

        .stat-card small {
            color: #777;
        }
    </style>
</head>

<body>

    <%- include('./partials/navbar.ejs') %>

    <div class="main-content">

        <div class="container-fluid px-4">

            <!-- HEADER -->
            <div class="mb-4">
                <h2>API Dashboard</h2>
                <p class="text-muted">Choose your API endpoint</p>
            </div>

            <!-- ALERT -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- API BUTTONS -->
            <div class="card mb-4">
                <div class="card-body">

                    <p class="text-muted">Select an API to explore:</p>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <button class="btn btn-custom btn-users" onclick="callUsersAPI()">
                                <i class="fas fa-users"></i>
                                Users API
                            </button>
                        </div>

                        <div class="col-md-6">
                            <button class="btn btn-custom btn-nusers" onclick="callNUsersAPI()">
                                <i class="fas fa-globe"></i>
                                External API
                            </button>
                        </div>

                    </div>

                    <div class="mt-3">
                        <small class="text-muted">
                            Users API: Local JSON data | External API: Third-party data
                        </small>
                    </div>

                </div>
            </div>

            <!-- STATS -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="stat-card">
                        <small>Total APIs</small>
                        <h3>3</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card">
                        <small>Datasets</small>
                        <h3>12</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card">
                        <small>Requests Today</small>
                        <h3>120</h3>
                    </div>
                </div>

            </div>

            <!-- RECENT ACTIVITY -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Recent Activity</h5>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Created new dataset</li>
                        <li class="list-group-item">Fetched external API</li>
                        <li class="list-group-item">Updated user data</li>
                    </ul>
                </div>
            </div>

            <!-- GUIDE -->
            <div class="card">
                <div class="card-body">
                    <h5>Quick Guide</h5>
                    <p class="text-muted mb-0">
                        Use <b>Users API</b> for local data and <b>External API</b> for third-party data.
                        You can also create your own datasets and access them via API endpoints.
                    </p>
                </div>
            </div>

        </div>

    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function callUsersAPI() {
            window.location.href = '/users';
        }

        function callNUsersAPI() {
            window.location.href = '/external';
        }
    </script>

</body>
</html>